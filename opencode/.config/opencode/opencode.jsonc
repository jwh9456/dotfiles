{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-gemini-auth@latest", "@dietrichgebert/ponytail"],
  "formatter": {
    "prettier": {
      "extensions": [".js", ".ts", ".jsx", ".tsx"],
    },
    "ktlint": {
      "extensions": [".kt", ".kts"],
    },
    "terraform": {
      "extensions": [".tf", ".tfvars"],
    },
  },
  "permission": {
    "webfetch": "allow",
    "question": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "skill": "allow",
    "lsp": "allow",
  },
  "agent": {
    "build": {
      "disable": true,
    },
    "plan": {
      "disable": true,
    },
  },
  "mcp": {
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "oauth": {},
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "oauth": {},
    },
  },
}
